# Mistral API key — used for both OCR (mistral-ocr-latest) and the
# OCR -> JSON transform (mistral-large-latest).
# Get one at https://admin.mistral.ai/organization and copy this file to `.env`.
MISTRAL_API_KEY=your-mistral-api-key-here

# Optional model overrides. The defaults are what a standard-tier key can use.
# NOTE: mistral-large-latest appears in models.list() but returns 403
# tier_not_allowed on lower tiers — do not assume listed means usable.
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_TRANSFORM_MODEL=mistral-medium-latest
