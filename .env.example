# ---------------------------------------------------------------------------
# Copy to `.env` and adjust as needed. No secrets are required: the app runs
# entirely in memory with no database and no authentication.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
API_PORT=4000

# Origin allowed to call the API (the Next.js dev server).
API_CORS_ORIGIN=http://localhost:3000

# Base URL the browser uses to reach the API. Must be NEXT_PUBLIC_* to be
# readable from client components.
NEXT_PUBLIC_API_URL=http://localhost:4000
